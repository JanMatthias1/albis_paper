# Single .gitignore for the repository (nested code/*/.gitignore files merged here 2026-09-30)

# System, Python and build artifacts
.DS_Store
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environments: installed environments and third-party checkouts; keep env/*.sh setup scripts
/env/*/
env/.venv/
env/albis-tutorial
env/*.log
env/slurm-*.out
tutorial/outputs/

# Data and local-only folders
/data/
/docs/
/code/misc/

# Archived / superseded code stays on disk but is not versioned
code/**/_archive/
code/**/archive/

# Job logs stay on disk but are not versioned
code/**/logs/
code/**/logs_*/

# Internal agent / assistant instruction files
AGENTS.md
CLAUDE.md
.claude/

# Internal working notes (not manuscript content); public docs are the per-folder READMEs
/SVG_PLAN.md
/figure.md
/FIGURE2_DRAFT.md
/figure_5.md
/FIGURE_FINALIZATION_AUDIT.md
/DATA_VERSIONS.md
**/README_PRIOR_TESTING.md
**/OUTPUT_POLICY_AUDIT.md

# code/applications_albis (Figure 4)
code/applications_albis/*/**/README.md
code/applications_albis/alignment/METHODS_reference_alignment_error.md

# code/data; public overview = code/data/README.md
code/data/README_internal.md

# code/clustering (Figure 3); public overview = code/clustering/README.md
code/clustering/README_internal.md
code/clustering/HISTORY_internal.md
code/clustering/README_PLOTTING.md
code/clustering/PATHS.md
code/clustering/*/**/README.md

# code/comparison_methods (Figure 5); public overview = code/comparison_methods/README.md
code/comparison_methods/*/**/README.md

# code/count_distribution (Figure 2); was code/count_distribution/.gitignore
code/count_distribution/**/README_internal.md
code/count_distribution/**/FIGURE2_METHODOLOGY.md
code/count_distribution/**/HISTORY_internal.md
code/count_distribution/misc/

# code/real_data_qc; was code/real_data_qc/.gitignore
code/real_data_qc/*/**/README.md
code/real_data_qc/**/_env.sh
/env/albis-banksy
